<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(MobileTargetFrameworks);$(NetVersion)</TargetFrameworks>

    <PackageId>Plugin.Maui.NearbyConnectivity</PackageId>
    <AssemblyName>Plugin.Maui.NearbyConnectivity</AssemblyName>
    <RootNamespace>Plugin.Maui.NearbyConnectivity</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Maui.Core" />
    <PackageReference Include="Xamarin.GooglePlayServices.Nearby" Condition="'$(IsTargetPlatformAndroid)' == 'true'" />
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>

    <!-- Tracks the public API surface in PublicAPI.{Shipped,Unshipped}.txt. Any addition,
         removal, or signature change to a public type or member fails the build until the
         corresponding entry is updated, so every API change arrives as a reviewable diff.
         Never suppress these diagnostics to get a build green — update the API files instead. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <InternalsVisibleTo Include="Plugin.Maui.NearbyConnectivity.UnitTests" />
    <InternalsVisibleTo Include="Plugin.Maui.NearbyConnectivity.DeviceTests" />
    <!-- NSubstitute proxies internal seams such as IPlatformConnection. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- Public API baseline wiring (per-TFM files, mode selection). See src/PublicAPI.targets. -->
  <Import Project="..\PublicAPI.targets" />
</Project>
