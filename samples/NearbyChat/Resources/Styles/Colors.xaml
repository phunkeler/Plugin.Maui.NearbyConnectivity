<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                    x:Class="NearbyChat.Resources.Styles.Colors">

    <!-- Generated from tokens.json by pwsh scripts/Sync-DesignTokens.ps1. -->
    <!-- Do not edit this file: change tokens.json and run the script again.              -->

    <!-- PRIMITIVES -->

    <!-- Primitive. Never used directly; alias it from a semantic token. -->
    <Color x:Key="Slate50">#f8fafc</Color>
    <!-- Primitive. -->
    <Color x:Key="Slate100">#f1f5f9</Color>
    <!-- Primitive. Incoming chat bubble and chat strips on light. -->
    <Color x:Key="Slate200">#e2e8f0</Color>
    <!-- Primitive. -->
    <Color x:Key="Slate300">#cbd5e1</Color>
    <!-- Primitive. -->
    <Color x:Key="Slate400">#94a3b8</Color>
    <!-- Primitive. -->
    <Color x:Key="Slate500">#64748b</Color>
    <!-- Primitive. -->
    <Color x:Key="Slate600">#475569</Color>
    <!-- Primitive. -->
    <Color x:Key="Slate700">#334155</Color>
    <!-- Primitive. -->
    <Color x:Key="Slate800">#1e293b</Color>
    <!-- Primitive. -->
    <Color x:Key="Slate900">#0f172a</Color>

    <!-- Primitive. The advertising hue's dark-theme step. -->
    <Color x:Key="Blue400">#60a5fa</Color>
    <!-- Primitive. The advertising hue. -->
    <Color x:Key="Blue600">#2563eb</Color>
    <!-- Primitive. Advertising shadow ink on light. -->
    <Color x:Key="Blue700">#1d4ed8</Color>

    <!-- Primitive. The discovery hue's dark-theme step. -->
    <Color x:Key="Green400">#4ade80</Color>
    <!-- Primitive. Accept ring on light. -->
    <Color x:Key="Green300">#86efac</Color>
    <!-- Primitive. Success pill ink, always at alpha. -->
    <Color x:Key="Green500">#22c55e</Color>
    <!-- Primitive. The discovery hue, and its shadow ink on light. -->
    <Color x:Key="Green700">#15803d</Color>
    <!-- Primitive. Success pill text on light. -->
    <Color x:Key="Green800">#166534</Color>

    <!-- Primitive. Countdown ring on light. -->
    <Color x:Key="Purple300">#c4b5fd</Color>
    <!-- Primitive. The connections hue's dark-theme step. -->
    <Color x:Key="Purple400">#a855f7</Color>
    <!-- Primitive. The connections hue. -->
    <Color x:Key="Purple600">#9333ea</Color>
    <!-- Primitive. Connections shadow ink on light. -->
    <Color x:Key="Purple700">#7e22ce</Color>
    <!-- Primitive. Outgoing chat bubble on dark. -->
    <Color x:Key="Purple950">#3b0764</Color>

    <!-- Primitive. Offer-window well and outgoing chat bubble on light. -->
    <Color x:Key="Violet100">#ede9fe</Color>
    <!-- Primitive. Offer-window seconds on light. -->
    <Color x:Key="Violet700">#6d28d9</Color>
    <!-- Primitive. Offer-window well on dark; not a Tailwind step. -->
    <Color x:Key="Violet950">#2a2440</Color>

    <!-- Primitive. Error's dark-theme step. -->
    <Color x:Key="Red400">#f87171</Color>
    <!-- Primitive. Expired pill ink, always at alpha. -->
    <Color x:Key="Red500">#ef4444</Color>
    <!-- Primitive. Error, and expired text, on light. -->
    <Color x:Key="Red700">#b91c1c</Color>

    <!-- Primitive. Warning's dark-theme step. -->
    <Color x:Key="Yellow400">#facc15</Color>
    <!-- Primitive. Warning pill ground, always at alpha. -->
    <Color x:Key="Yellow600">#ca8a04</Color>
    <!-- Primitive. Warning on light. -->
    <Color x:Key="Yellow800">#854d0e</Color>

    <!-- Primitive. Text on any accent fill. -->
    <Color x:Key="White">#ffffff</Color>

    <!-- Primitive. Card shadow on dark. -->
    <Color x:Key="Black">#000000</Color>

    <!-- SEMANTIC -->

    <!-- Page ground. XAML: Background. -->
    <toolkit:AppThemeColor x:Key="Background" Light="{StaticResource Slate50}" Dark="{StaticResource Slate900}"/>

    <!-- Cards and the sheet. One step off the ground, never a border. XAML: Surface. -->
    <toolkit:AppThemeColor x:Key="Surface" Light="{StaticResource Slate100}" Dark="{StaticResource Slate800}"/>
    <!-- A well inside a card, back at ground level. XAML: SurfaceSecondary. -->
    <toolkit:AppThemeColor x:Key="SurfaceSecondary" Light="{StaticResource Slate50}" Dark="{StaticResource Slate900}"/>

    <!-- A 1px rule between rows inside a surface, and under the chat sheet's header. One step lighter than surface on dark, one step darker on light. XAML: Divider. -->
    <toolkit:AppThemeColor x:Key="Divider" Light="{StaticResource Slate300}" Dark="{StaticResource Slate700}"/>

    <!-- Titles, device names, the auth code. XAML: TextPrimary. -->
    <toolkit:AppThemeColor x:Key="TextPrimary" Light="{StaticResource Slate900}" Dark="{StaticResource White}"/>
    <!-- Card subtitles and the chevron. XAML: TextSecondary. -->
    <toolkit:AppThemeColor x:Key="TextSecondary" Light="{StaticResource Slate700}" Dark="{StaticResource Slate300}"/>
    <!-- List headers, neutral pill text and the Back button's outline. XAML: TextTertiary. -->
    <toolkit:AppThemeColor x:Key="TextTertiary" Light="{StaticResource Slate600}" Dark="{StaticResource Slate400}"/>
    <!-- The attach icon and the device-row dot. Same step both themes. XAML: TextQuaternary. -->
    <toolkit:AppThemeColor x:Key="TextQuaternary" Light="{StaticResource Slate500}" Dark="{StaticResource Slate500}"/>

    <!-- Advertising's fill: its badge, its Start button. XAML: AccentAdvertising. -->
    <StaticResource x:Key="AccentAdvertising" Key="Blue600"/>
    <!-- Advertising badge shadow brush: blue-700 at 10% on light, blue-400 on dark. XAML: AccentAdvertisingShadow. -->
    <toolkit:AppThemeColor x:Key="AccentAdvertisingShadow" Light="#1a1d4ed8" Dark="{StaticResource Blue400}"/>
    <!-- Discovery's fill, the Chat and Accept buttons, and the one filled answer in the auth-code card. Green-700 so white text clears 4.5:1. XAML: AccentDiscovery. -->
    <StaticResource x:Key="AccentDiscovery" Key="Green700"/>
    <!-- Discovery badge shadow brush: green-700 at 10% on light, green-400 on dark. XAML: AccentDiscoveryShadow. -->
    <toolkit:AppThemeColor x:Key="AccentDiscoveryShadow" Light="#1a15803d" Dark="{StaticResource Green400}"/>
    <!-- Connections' fill: its badge, the chip, the send button, the countdown fill. XAML: AccentConnections. -->
    <StaticResource x:Key="AccentConnections" Key="Purple600"/>
    <!-- Text-only actions in the connections hue, such as Remove and Cancel on the chat strips. Clears 4.5:1 on chat-bubble in both themes. XAML: AccentConnectionsText. -->
    <toolkit:AppThemeColor x:Key="AccentConnectionsText" Light="{StaticResource Purple700}" Dark="{StaticResource Purple300}"/>
    <!-- Connections badge shadow brush: purple-700 at 10% on light, purple-400 on dark. XAML: AccentConnectionsShadow. -->
    <toolkit:AppThemeColor x:Key="AccentConnectionsShadow" Light="#1a7e22ce" Dark="{StaticResource Purple400}"/>

    <!-- The draining ring's resting colour. XAML: CountdownRing. -->
    <toolkit:AppThemeColor x:Key="CountdownRing" Light="{StaticResource Purple300}" Dark="{StaticResource Purple400}"/>

    <!-- Stroke on a stat chip while its sheet is open. Same steps as countdown-ring. XAML: ChipRing. -->
    <toolkit:AppThemeColor x:Key="ChipRing" Light="{StaticResource Purple300}" Dark="{StaticResource Purple400}"/>

    <!-- The Accept button's ring on the advertising page. XAML: AccentDiscoveryRing. -->
    <toolkit:AppThemeColor x:Key="AccentDiscoveryRing" Light="{StaticResource Green300}" Dark="{StaticResource Green400}"/>

    <!-- The seconds-remaining well on a discovered device row. XAML: OfferWindowSurface. -->
    <toolkit:AppThemeColor x:Key="OfferWindowSurface" Light="{StaticResource Violet100}" Dark="{StaticResource Violet950}"/>
    <!-- The seconds in that well. XAML: OfferWindowText. -->
    <toolkit:AppThemeColor x:Key="OfferWindowText" Light="{StaticResource Violet700}" Dark="{StaticResource Purple400}"/>

    <!-- Failed sends, the outlined Disconnect and mismatch buttons, the warning ring band. Text and outline only, never a fill under white: red-700 on light and red-400 on dark clear 4.5:1 on a card, the sheet and both bubbles. XAML: StatusError. -->
    <toolkit:AppThemeColor x:Key="StatusError" Light="{StaticResource Red700}" Dark="{StaticResource Red400}"/>
    <!-- Unverified text, the held-count badge, the Verify button, the caution ring band. Clears 4.5:1 on status-warning-surface over a card in both themes; text on its fill is white on light, slate-900 on dark. XAML: StatusWarning. -->
    <toolkit:AppThemeColor x:Key="StatusWarning" Light="{StaticResource Yellow800}" Dark="{StaticResource Yellow400}"/>
    <!-- Informational pill ink: blue-600 on light, blue-400 on dark. XAML: StatusInfo. -->
    <toolkit:AppThemeColor x:Key="StatusInfo" Light="{StaticResource Blue600}" Dark="{StaticResource Blue400}"/>
    <!-- Verified pill ground: green-500 at 8%. XAML: StatusSuccessSurface. -->
    <Color x:Key="StatusSuccessSurface">#1422c55e</Color>
    <!-- Verified pill text and its check. Clears 4.5:1 on status-success-surface over a card or the sheet in both themes. XAML: StatusSuccessText. -->
    <toolkit:AppThemeColor x:Key="StatusSuccessText" Light="{StaticResource Green800}" Dark="{StaticResource Green400}"/>
    <!-- Info pill ground: blue-600 at 16%. XAML: StatusInfoSurface. -->
    <Color x:Key="StatusInfoSurface">#292563eb</Color>
    <!-- Default pill ground: slate-500 at 16%. Text is text-tertiary. XAML: StatusNeutralSurface. -->
    <Color x:Key="StatusNeutralSurface">#2964748b</Color>
    <!-- Unverified pill ground: yellow-600 at 16%. XAML: StatusWarningSurface. -->
    <Color x:Key="StatusWarningSurface">#29ca8a04</Color>
    <!-- Expired pill ground: red-500 at 8%. Muted; a lapsed request is expected, not an error. XAML: StatusExpiredSurface. -->
    <Color x:Key="StatusExpiredSurface">#14ef4444</Color>
    <!-- Expired pill and expired countdown text. Opaque, so it clears 4.5:1 on status-expired-surface over a card in both themes. XAML: StatusExpiredText. -->
    <toolkit:AppThemeColor x:Key="StatusExpiredText" Light="{StaticResource Red700}" Dark="{StaticResource Red400}"/>

    <!-- Incoming bubble ground, and the attachment and receive strips. One step off the sheet in each theme, so the shape still reads on light. XAML: ChatBubble. -->
    <toolkit:AppThemeColor x:Key="ChatBubble" Light="{StaticResource Slate200}" Dark="{StaticResource Slate800}"/>
    <!-- Outgoing bubble ground, in the hue of the send button: a pale tint on light, and on dark a deep one, dim enough that a photo stays the brightest thing in it. XAML: ChatBubbleOutgoing. -->
    <toolkit:AppThemeColor x:Key="ChatBubbleOutgoing" Light="{StaticResource Violet100}" Dark="{StaticResource Purple950}"/>
    <!-- Message text, and the outlined Retry on a failed send. XAML: ChatBubbleText. -->
    <toolkit:AppThemeColor x:Key="ChatBubbleText" Light="{StaticResource Slate900}" Dark="{StaticResource White}"/>
    <!-- The failure remedy line inside a bubble. XAML: ChatBubbleMediaText. -->
    <toolkit:AppThemeColor x:Key="ChatBubbleMediaText" Light="{StaticResource Slate600}" Dark="{StaticResource Slate300}"/>
    <!-- Timestamp, right-aligned. Clears 4.5:1 on both bubbles in both themes. XAML: ChatBubbleTimestamp. -->
    <toolkit:AppThemeColor x:Key="ChatBubbleTimestamp" Light="{StaticResource Slate600}" Dark="{StaticResource Slate400}"/>

    <!-- Card shadow brush: slate-900 at 30% on light, black on dark; MAUI draws it at 60% opacity. XAML: CardShadow. -->
    <toolkit:AppThemeColor x:Key="CardShadow" Light="#4d0f172a" Dark="{StaticResource Black}"/>

</ResourceDictionary>
