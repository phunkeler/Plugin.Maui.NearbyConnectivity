<CardView
    x:Class="NearbyChat.Controls.FeatureNavigationCard"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="this"
    x:DataType="FeatureNavigationCard"
    AutomationId="{Binding TapAutomationId, Source={x:Reference this}}"
    Style="{StaticResource FeatureNavigationCardBorderStyle}">
    <CardView.GestureRecognizers>
        <TapGestureRecognizer Command="{Binding Command, Source={x:Reference this}}"/>
    </CardView.GestureRecognizers>
    <!-- A page dims a disabled card by its Opacity. The shadow would show through the
         half-transparent card and turn it into a grey slab on the light theme, so it goes. -->
    <CardView.Triggers>
        <Trigger TargetType="CardView"
                 Property="IsEnabled"
                 Value="False">
            <Setter Property="Shadow"
                    Value="{x:Null}"/>
        </Trigger>
    </CardView.Triggers>

    <!-- Main Content -->
    <Grid ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="{StaticResource SpacingLG}">

        <FeatureIconBadge Style="{Binding FeatureIconBadgeStyle, Source={x:Reference this}}"/>


        <!-- Text Content -->
        <VerticalStackLayout Grid.Column="1"
                             VerticalOptions="Center"
                             Spacing="4">
            <Label Text="{Binding Title, Source={x:Reference this}}"
                   Style="{StaticResource CardTitle}"/>
            <Label
                Style="{StaticResource CardSubtitle}">

                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding FeatureIsActive, Source={x:Reference this}}"
                                 Value="True">
                        <Setter Property="Text"
                                Value="{Binding ActiveSubtitle, Source={x:Reference this}}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding FeatureIsActive, Source={x:Reference this}}"
                                 Value="False">
                        <Setter Property="Text"
                                Value="{Binding Subtitle, Source={x:Reference this}}"/>
                    </DataTrigger>
                </Label.Triggers>

            </Label>
        </VerticalStackLayout>

        <!-- Chevron -->
        <Image
            Grid.Column="2"
            WidthRequest="12"
            HeightRequest="12">
            <Image.Source>
                <FontImageSource FontFamily="NearbyChatIcons"
                                 Glyph="{StaticResource icon-right}"
                                 Color="{toolkit:AppThemeResource TextSecondary}"/>
            </Image.Source>
        </Image>
    </Grid>

</CardView>
